generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  tagline   String
  category  String
  basePrice Int
  featured  Boolean  @default(false)
  heroImage String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  colors   ColorVariant[]
  storage  StorageVariant[]
  specs    ProductSpec[]
  images   ProductImage[]
}

model ColorVariant {
  id        Int     @id @default(autoincrement())
  name      String
  hex       String
  imageUrl  String
  sortOrder Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model StorageVariant {
  id        Int     @id @default(autoincrement())
  label     String
  priceAdd  Int
  sortOrder Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSpec {
  id        Int     @id @default(autoincrement())
  label     String
  value     String
  sortOrder Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  sortOrder Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Tile {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  category  String
  size      String
  finish    String
  origin    String
  price     Int
  image     String
  featured  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
